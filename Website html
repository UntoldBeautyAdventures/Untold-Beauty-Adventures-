  <meta name="description"
        content="Untold Beauty Adventures offers Kilimanjaro and Mount Meru trekking, Tanzania wildlife safaris, Zanzibar beach holidays, cultural tours, day trips and professional travel logistics.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #333;
      line-height: 1.6;
      background: #f8f6f0;
    }

    /* NAVIGATION */
    nav {
      position: fixed;
      top: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(35, 48, 31, 0.95);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 7%;
    }

    .logo {
      color: #e7d7a5;
      font-size: 22px;
      font-weight: bold;
      letter-spacing: 1px;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 25px;
    }

    nav ul li a {
      color: white;
      text-decoration: none;
      font-size: 15px;
    }

    nav ul li a:hover {
      color: #e0c27b;
    }

    /* HERO */
    .hero {
      height: 100vh;
      min-height: 650px;
      background:
        linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.55)),
        url("https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=2000&q=85")
        center/cover;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      padding: 20px;
    }

    .hero-content {
      max-width: 900px;
    }

    .hero h1 {
      font-size: 58px;
      line-height: 1.1;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: #e4c878;
    }

    .hero p {
      font-size: 20px;
      max-width: 750px;
      margin: auto;
    }

    .buttons {
      margin-top: 35px;
    }

    .btn {
      display: inline-block;
      padding: 14px 27px;
      margin: 7px;
      border-radius: 5px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn-primary {
      background: #c8a85d;
      color: white;
    }

    .btn-primary:hover {
      background: #a88945;
    }

    .btn-outline {
      border: 2px solid white;
      color: white;
    }

    .btn-outline:hover {
      background: white;
      color: #333;
    }

    /* INTRO */
    section {
      padding: 80px 8%;
    }

    .section-title {
      text-align: center;
      margin-bottom: 45px;
    }

    .section-title h2 {
      font-size: 38px;
      color: #30412d;
      margin-bottom: 10px;
    }

    .section-title p {
      max-width: 700px;
      margin: auto;
      color: #666;
    }

    .intro {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: center;
      background: white;
    }

    .intro h2 {
      color: #30412d;
      font-size: 38px;
      margin-bottom: 20px;
    }

    .intro p {
      margin-bottom: 15px;
      color: #555;
    }

    .intro-image img {
      width: 100%;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    /* SERVICES */
    .services {
      background: #f1eee5;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
    }

    .card {
      background: white;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-7px);
    }

    .card img {
      width: 100%;
      height: 210px;
      object-fit: cover;
    }

    .card-content {
      padding: 25px;
    }

    .card h3 {
      color: #30412d;
      margin-bottom: 10px;
      font-size: 22px;
    }

    .card p {
      color: #666;
      font-size: 15px;
    }

    /* WHY US */
    .why-us {
      background: #30412d;
      color: white;
    }

    .why-us .section-title h2 {
      color: #e6d29b;
    }

    .why-us .section-title p {
      color: #ddd;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
      text-align: center;
    }

    .feature {
      padding: 20px;
    }

    .feature .icon {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .feature h3 {
      margin-bottom: 10px;
      color: #e6d29b;
    }

    /* DESTINATIONS */
    .destinations {
      background: white;
    }

    .destination-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .destination {
      height: 300px;
      border-radius: 10px;
      overflow: hidden;
      position: relative;
    }

    .destination img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: 0.4s;
    }

    .destination:hover img {
      transform: scale(1.08);
    }

    .destination-text {
      position: absolute;
      bottom: 0;
      width: 100%;
      padding: 25px 15px;
      background: linear-gradient(transparent, rgba(0,0,0,0.85));
      color: white;
    }

    .destination-text h3 {
      font-size: 23px;
    }

    /* CTA */
    .cta {
      background:
        linear-gradient(rgba(31,46,28,0.85), rgba(31,46,28,0.85)),
        url("https://images.unsplash.com/photo-1547036967-23d11aacaee0?auto=format&fit=crop&w=2000&q=80")
