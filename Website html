      text-align: center;
      color: white;
    }

    .cta h2 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .cta p {
      max-width: 700px;
      margin: auto;
      font-size: 18px;
    }

    /* FOOTER */
    footer {
      background: #1e281b;
      color: white;
      padding: 50px 8% 20px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 35px;
    }

    footer h3 {
      color: #e6d29b;
      margin-bottom: 15px;
    }

    footer p {
      color: #ccc;
    }

    footer ul {
      list-style: none;
    }

    footer ul li {
      margin-bottom: 8px;
    }

    footer a {
      color: #ccc;
      text-decoration: none;
    }

    footer a:hover {
      color: #e6d29b;
    }

    .copyright {
      text-align: center;
      border-top: 1px solid #465040;
      padding-top: 20px;
      color: #aaa;
      font-size: 14px;
    }

    /* MOBILE */
    @media (max-width: 900px) {

      nav ul {
        display: none;
      }

      .hero h1 {
        font-size: 42px;
      }

      .intro {
        grid-template-columns: 1fr;
      }

      .cards {
        grid-template-columns: 1fr 1fr;
      }

      .features {
        grid-template-columns: 1fr 1fr;
      }

      .destination-grid {
        grid-template-columns: 1fr 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {

      section {
        padding: 60px 5%;
      }

      .hero h1 {
        font-size: 36px;
      }

      .hero p {
        font-size: 17px;
      }

      .cards,
      .features,
      .destination-grid {
        grid-template-columns: 1fr;
      }

      .section-title h2 {
        font-size: 30px;
      }
    }
